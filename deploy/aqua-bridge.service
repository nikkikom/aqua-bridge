[Unit]
Description=aqua-bridge MPC fan controller (aquaero 6 XT + Quadro)
Documentation=file:///opt/aqua-bridge/PROJECT.md
# Deliberately NO Wants=/After=network-online.target (it was here until the
# watchdog work; PROJECT.md §2 "the network is outside the cooling path").
# The daemon controls the fans over USB and needs no network at all: MQTT
# connects asynchronously with automatic reconnects, the HTTPS API binds
# 0.0.0.0 and a bind failure only turns the API off, and Home Assistant
# discovery is a publish like any other. Ordering after that target would
# instead hold the fans hostage to the router: NetworkManager-wait-online waits
# its full 30 s default when nothing associates, and this board takes 28 s from
# power to its first controller write as it is -- two windows the aquaero's own
# 30 s software-sensor timeout would spend on a boot with the router switched
# off. After=network.target is not needed either: it orders nothing that
# matters here and would only add a second name to keep true.
#
# No start rate limiting ([Unit], not [Service], since systemd 229). systemd's
# default -- 5 starts in 10 s, then the unit is parked in "failed" -- is the one
# way this unit can go silent: parked means nothing writes the controllers and
# nothing writes the aquaero's software sensor ever again, and only the
# controller's own watchdog saves the drives. A daemon that keeps trying is
# always better than one systemd has given up on (PROJECT.md §2: a failure never
# reduces cooling). With RestartSec=5 below, "keeps trying" costs one start
# every five seconds.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# User= below is a placeholder; deploy/install-pi.sh substitutes the real
# service account name at install time (site-specific names stay out of git).
User=aqua
# plugdev: the udev rule in deploy/99-aquacomputer.rules gives that group
# read/write access to the aquaero's and the Quadro's /dev/hidrawN nodes (the
# kernel creates them root:root 0600; without the rule the daemon cannot open
# them and the unit loops on the start timeout). dialout: the Digole UART.
SupplementaryGroups=dialout plugdev
# NotifyAccess=main + no shell wrapper: ExecStart= must be the venv
# interpreter running -m aqua_bridge directly, so the main PID is the
# process that calls sd_notify (see PROJECT.md §9).
ExecStart=/opt/aqua-bridge/.venv/bin/python -m aqua_bridge --config /etc/aqua-bridge/config.yaml
# /var/lib/aqua-bridge, owned by User=, exported as $STATE_DIRECTORY: a DAS config keeps
# its thermal model and SMART calibrations in $STATE_DIRECTORY/model.json (written
# atomically every model_store_interval_s and at the clean stop). A legacy config ignores
# it. Delete model.json for a clean prior (the calibrations go with it).
StateDirectory=aqua-bridge
# /run/aqua-bridge, owned by User=, tmpfs and re-created empty on every start:
# onewire.lock_path's default (hw/onewire.py, ReaderLock) lives here, held for
# as long as the 1-Wire reader threads run so tools/w1_commission.py --check
# can tell this daemon is reading before it measures the same buses (PROJECT.md
# item 39, "a cross-process lock is a different animal"). Meaningless across a
# restart by design -- unlike StateDirectory above, nothing here is preserved.
RuntimeDirectory=aqua-bridge
Restart=always
# 5 s, not systemd's 100 ms default: it keeps a daemon that exits immediately
# (a config error) from spinning the CPU and the journal, and it is far inside
# the aquaero's 30 s software-sensor timeout, so a crash or a clean restart
# never costs a fan alarm by itself. A watchdog kill is the one case where the
# alarm has already fired before the restart begins -- see WatchdogSec below.
RestartSec=5
# Two WATCHDOG=1 pings further apart than this and systemd kills the daemon.
# The bound the daemon checks itself at startup against $WATCHDOG_USEC
# (hw/aquacomputer_adapter.py::check_watchdog) is mpc.dt + mpc.budget_alarm_ms
# + the controllers' worst-case I/O: 19 s for config.example-das.yaml as it
# ships, 32 s with the Quadro on its own USB port. The rest of the 45 s is the
# margin for what that bound does not count -- the publishers and the recorder,
# whose largest single item is one vcgencmd at host_health.vcgencmd_timeout_s
# (2 s, at most once a minute).
# 45 s is ABOVE the aquaero's own 30 s software-sensor timeout, and it has to
# be: the bound above is already 32 s in the two-controller layout, so there is
# no value that both stays clear of a legitimate slow tick and beats the
# controller. What follows from that, and is the honest answer to "what happens
# to the fans during a watchdog restart" (PROJECT.md §2 has the timeline):
# systemd firing this watchdog *means* no tick finished for 45 s, and with
# heartbeat_sensor set the heartbeat goes out inside apply() on a tick that
# succeeded -- so at 30 s the software sensor has already fallen back, the alarm
# has already selected the 100 % profile, and every fan is already at 100 %
# fifteen seconds before the kill. The restart is what ends that, not what
# causes it. (With heartbeat_sensor: 0 and a separate service feeding the
# sensor, as the board runs today, the stall is invisible to the controller and
# the fans simply hold.)
# WatchdogSignal is left at SIGABRT on purpose. SIGTERM would run the daemon's
# stop path, which writes fallback_pwm through the very sink whose slowness
# tripped the watchdog: it would block until TimeoutStopSec and be SIGKILLed
# anyway, only later -- and it would jolt the fans to fallback_pwm on every
# timeout. So: the process dies at once and writes nothing, Restart=always
# brings the daemon back after RestartSec, and its first tick has no last_cmd,
# so it takes prev from the duty it reads off the device -- the alarm's 100 %
# if the alarm is up -- and rate-limits from there. Its first successful apply
# resumes the heartbeat, the alarm clears within ~2 s, and the profile switch
# back reloads the SAVED profile, so the duties just written live are gone and
# the outputs drop to that profile's preset until the duty verification sees
# the mismatch and rewrites every channel (duty_mismatch_s plus a tick).
WatchdogSec=45
# READY=1 is sent after the first tick whose command reached the device, so
# a device that is absent at boot (USB not yet enumerated, hidraw permissions
# wrong) shows up as a start timeout followed by Restart=always -- the
# visible "device absent" state. Long enough for a slow USB enumeration on
# the Zero W, short enough that the journal shows the problem quickly.
TimeoutStartSec=120
# No ExecStop=: systemd would run it while the main process is still
# alive (then send SIGTERM), giving two writers to the controllers at once. The
# daemon's own SIGTERM handler writes fallback_pwm and exits; that is
# the only stop path.
#
# Deploy side effect (accepted, PROJECT.md §9): `systemctl restart` is a
# clean stop, so on every restart the fans jump to fallback_pwm (0.8 in
# config.example.yaml) and then ramp back down at d_pwm_max per tick —
# on the order of ten seconds with the example config. Do not mistake a
# restart for a thermal event.

[Install]
WantedBy=multi-user.target
